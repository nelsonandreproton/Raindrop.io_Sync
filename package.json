    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "node-html-parser": "^6.1.0"
  }
